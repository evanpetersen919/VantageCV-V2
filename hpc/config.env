# Defaults. Put YOUR cluster's values in hpc/config.local.env (same variable names, git-ignored)
# instead of editing this file, so `git pull` never conflicts with your settings.
export HPC_ROOT="$HOME/vantagecv"   # data, repo, venv, runs, results all live under here
                                    # (use your scratch/work filesystem if $HOME is small: ~15 GB needed)
export SLURM_PARTITION="gpu"        # `sinfo -o "%P %G %l"` lists partitions, GPUs and time limits
export SLURM_ACCOUNT=""             # leave empty unless your site requires an account (-A)
export SLURM_GRES="gpu:1"           # one GPU per job (a run uses ~10 GB of GPU memory)
export SLURM_CPUS="8"
export SLURM_MEM="48G"
export SLURM_TIME="12:00:00"        # a 200-epoch run on 1,838 images is ~2.5 h on an RTX 4080-class GPU;
                                    # the mixed (3,676-image) run is ~5 h. Raise if the GPU is slower.
export MODULES=""                   # space-separated, e.g. "python/3.11 cuda/12.6"; empty if none needed
export TORCH_INDEX="https://download.pytorch.org/whl/cu126"   # match the cluster's CUDA driver
